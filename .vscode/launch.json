{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "MiniBank API (Launch)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/MiniBank.API/bin/Debug/net10.0/MiniBank.API.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/MiniBank.API",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/scalar/v1"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    }
  ]
}

